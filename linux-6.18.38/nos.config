# nOS minimal kernel config fragment (applied on top of tinyconfig)

# Architecture
CONFIG_64BIT=y

# Keep minimal footprint
CONFIG_CC_OPTIMIZE_FOR_SIZE=y
CONFIG_KERNEL_XZ=y
CONFIG_SLUB_TINY=y
CONFIG_TINY_RCU=y
CONFIG_TINY_SRCU=y
CONFIG_UNWINDER_GUESS=y

# Block layer (off by default in allnoconfig)
CONFIG_BLOCK=y

# PCI (needed for NVMe, virtio)
CONFIG_PCI=y
CONFIG_PCI_MSI=y
CONFIG_PCI_DIRECT=y
CONFIG_PCI_MMCONFIG=y

# Executable formats
CONFIG_BINFMT_ELF=y
CONFIG_BINFMT_SCRIPT=y

# Filesystems
CONFIG_EXT4_FS=y
CONFIG_EXT4_USE_FOR_EXT2=y
CONFIG_PROC_FS=y
CONFIG_SYSFS=y
CONFIG_TMPFS=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y

# Block devices
CONFIG_VIRTIO_BLK=y
CONFIG_BLK_DEV_NVME=y

# Virtio
CONFIG_VIRTIO=y
CONFIG_VIRTIO_PCI=y
CONFIG_VIRTIO_PCI_LEGACY=y

# Console
CONFIG_TTY=y
CONFIG_VT=y
CONFIG_VT_CONSOLE=y
CONFIG_HW_CONSOLE=y
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_CONSOLE=y
CONFIG_SERIAL_8250_PCI=y
CONFIG_EARLY_PRINTK=y
CONFIG_EARLY_PRINTK_DBGP=y

# ACPI (needed for QEMU q35 serial port discovery)
CONFIG_ACPI=y
CONFIG_PNP=y

# Initramfs
CONFIG_BLK_DEV_INITRD=y

# Misc
CONFIG_PRINTK=y
CONFIG_SHMEM=y
